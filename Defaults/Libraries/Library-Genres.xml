<?xml version="1.0" standalone="yes"?>
<GenreLibrary>
  <xs:schema id="GenreLibrary" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xs:element name="GenreLibrary" msdata:IsDataSet="true" msdata:Locale="de-DE">
      <xs:complexType>
        <xs:choice maxOccurs="unbounded">
          <xs:element name="Genres">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Name" type="xs:string" />
                <xs:element name="V1V2" type="xs:unsignedByte" minOccurs="0" />
                <xs:element name="V2V1" type="xs:unsignedByte" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="GenreCons" msdata:PrimaryKey="true">
        <xs:selector xpath=".//Genres" />
        <xs:field xpath="Name" />
      </xs:unique>
    </xs:element>
  </xs:schema>
</GenreLibrary>